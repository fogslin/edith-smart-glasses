# ---- EDITH backend configuration (copy to .env and fill in) ----
# Shared secret the glasses send in X-Device-Token (must match DEVICE_TOKEN in the .ino)
DEVICE_TOKEN=change-me-device-token

# ---- LLM: any OpenAI-compatible, vision-capable chat/completions endpoint ----
# xAI Grok (default). Check https://docs.x.ai/docs/models for current model names.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=xai-REPLACE_ME
LLM_MODEL=grok-4.7
# OpenAI example:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Local example (Ollama/LM Studio): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llava
LLM_MAX_TOKENS=300

# ---- Speech to text ----
# openai = any OpenAI-compatible /audio/transcriptions (Whisper API); local = faster-whisper on this PC
STT_PROVIDER=openai
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=sk-REPLACE_ME
STT_MODEL=whisper-1
LOCAL_WHISPER_MODEL=small

# ---- Text to speech ----
# openai = OpenAI-compatible /audio/speech; espeak = local espeak-ng; none = text only
TTS_PROVIDER=openai
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-REPLACE_ME
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova

# ---- Files ----
PERSONALITY_FILE=../prompts/personality.md
MUSIC_DIR=./music

# ---- Tesla (optional) ----
# off | fleet (cloud, via tesla-http-proxy) | ble (tesla-control on a host near the car)
TESLA_MODE=off
TESLA_VIN=YOUR_VIN
TESLA_CLIENT_ID=your-developer-app-client-id
TESLA_CLIENT_SECRET=your-developer-app-client-secret
TESLA_APP_DOMAIN=your-domain.example
TESLA_REDIRECT_URI=https://your-domain.example/auth/callback
# North America/APAC: https://fleet-api.prd.na.vn.cloud.tesla.com  EMEA: https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_FLEET_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_PROXY_URL=https://localhost:4443
TESLA_PROXY_CA=./config/tls-cert.pem
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=
TESLA_ALLOW_UNLOCK=false
TESLA_BLE_KEY_FILE=./config/ble-private-key.pem
